# Sub-path the site is served from (e.g. /O.M for GitHub Pages). Empty for a domain root.
NEXT_PUBLIC_BASE_PATH=
# Absolute site URL (canonical, hreflang, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.fc-om.com
# Optional: Formspree endpoint for the contact form. Leave empty to use the mailto: fallback.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
